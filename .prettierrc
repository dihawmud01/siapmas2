{
    "printWidth": 120,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "trailingComma": "all",
    "tailwindConfig": "./tailwind.config.js",
    "plugins": [
        "prettier-plugin-blade",
        "prettier-plugin-tailwindcss",
        "@prettier/plugin-php",
        "prettier-plugin-css-order"
    ],
    "overrides": [
        {
            "files": [
                "*.blade.php",
                "*.php"
            ],
            "options": {
                "parser": "blade"
            }
        }
    ]
}
